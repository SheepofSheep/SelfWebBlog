* text=auto eol=lf

# Windows launch scripts are consumed by cmd.exe / PowerShell.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Keep generated and checked-in binary assets byte-for-byte stable.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.jar binary
*.xdb binary
